{
  "name": "pano",
  "productName": "Pano",
  "version": "0.1.0",
  "description": "Claude ajanlarını tek pencereden yönetme",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "paketle": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "tr.jollin.pano",
    "productName": "Pano",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "bin/**",
      "hooks/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "bin/**",
      "hooks/**",
      "node_modules/**"
    ],
    "electronVersion": "44.5.1"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "@xterm/xterm": "5.5.0",
    "@xterm/addon-fit": "0.10.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "@electron/rebuild": "4.0.1",
    "electron-builder": "26.0.12"
  }
}